{
  "name": "rl-island",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/browser-tests.mjs test",
    "build": "vite build",
    "preview": "node scripts/static-preview.mjs",
    "audit:references": "node scripts/audit-references.mjs",
    "capture:reference": "node scripts/capture-reference.mjs",
    "setup:browser": "node scripts/browser-tests.mjs install chromium",
    "capture:components": "node scripts/capture-dev.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "chart.js": "4.5.1",
    "katex": "0.18.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
